{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",

  "//": "The shop is the site root here, so assets sit at / rather than /store/, and the build stays in this folder instead of being written into the Python project.",
  "buildCommand": "VITE_BASE=/ VITE_OUT_DIR=dist npm run build",
  "outputDirectory": "dist",

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

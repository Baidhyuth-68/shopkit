# Copy this file to ".env" and edit the values. Never commit the real .env.

# ---------- Database ----------
# Local file database (default, zero setup):
 DATABASE_URL=postgresql://neondb_owner:npg_mFEPpz0O1dUB@ep-tiny-base-azq7s9zq-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Hosted / online Postgres. Pick ONE and uncomment it.
# Neon:     postgresql+psycopg://user:password@ep-xxx.aws.neon.tech/shop?sslmode=require
# Supabase: postgresql+psycopg://postgres:password@db.xxx.supabase.co:5432/postgres
# Railway:  postgresql+psycopg://postgres:password@containers.railway.app:1234/railway
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-going-live
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- First admin account (created on first run) ----------
ADMIN_EMAIL=admin@myshop.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Store Owner

# ---------- Misc ----------
# Comma-separated list, or * for any origin. Only needed if the frontend is
# hosted on a different domain than the API.
CORS_ORIGINS=*
SEED_DEMO_DATA=true
MAX_UPLOAD_MB=5

# --- API reference ---
# /docs asks for an API credential before it opens: Client ID as the username,
# Client secret as the password. Set this to true to let anyone read it. The
# endpoints themselves are protected either way.
DOCS_PUBLIC=false
